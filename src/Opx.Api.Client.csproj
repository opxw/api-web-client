<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Opx.Api.Client</AssemblyName>
    <RootNamespace>Opx.Api.Client</RootNamespace>
    <PackageId>Opx.Api.Client</PackageId>
    <Title>Opx.Api.Client</Title>
    <Authors>Noviyanto Wibowo</Authors>
    <Company>opx</Company>
    <Product>Opx.Api.Client</Product>
    <Description>Typed HTTP, streaming multipart transfer, download, and reconnecting WebSocket client for Opx.Api.Web.</Description>
    <Copyright>Copyright (c) 2026 - opx</Copyright>
    <PackageTags>opx;api;client;http;websocket;realtime;wrapper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.13</Version>
    <AssemblyVersion>1.0.13</AssemblyVersion>
    <FileVersion>1.0.13.20260817</FileVersion>
    <InformationalVersion>1.0.13.20260817</InformationalVersion>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <NoWarn>$(NoWarn);7035</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>
</Project>
